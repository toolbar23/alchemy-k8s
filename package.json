{
  "name": "alchemy-k3s-workspace",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "Alchemy extensions for Hetzner and local k3s clusters",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22",
    "npm": ">=12.0.2 <13"
  },
  "allowScripts": {
    "fsevents": false,
    "msgpackr-extract": false,
    "workerd": false
  },
  "workspaces": [
    "packages/hetzner",
    "packages/docker"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run pack:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && npm run format:check",
    "pack:check": "node scripts/check-packages.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  }
}
